# ArangoDB（必填——库结构见 AI-Math-Solving-Databases 仓库，恢复方法见 docs/RESTORE-GUIDE.md）
ARANGO_HOST=http://localhost:8529
ARANGO_DB=xishujuzhen_math_glm52
ARANGO_USER=root
ARANGO_PASS=your_password_here

# 外部数据路径（必填——全部指向你本机的目录，任意布局均可；内容来源见 docs/RESTORE-GUIDE.md 映射表）
# 解题工作目录基座：当前世代内容 = AI-Math-Solving-Trajectories/p27-workdirs + Archive/workdirs
SOLVER_BASE=/path/to/your/solver-base
# 轨迹基座：当前世代 = AI-Math-Solving-Trajectories/{p27-continuation,v2-continuation,p27-sop-reports} + Archive/runs
TRAJECTORY_BASE=/path/to/your/trajectory-base
# 上游原始数据集（可选：公开数据集按 README URL 自行下载；题目本体已全量在 DB 内）
DATASET_BASE=/path/to/your/datasets

# 题库目录（指向 AI-Math-Solving-Databases/problem-bank-catalogs 的 clone 位置；索引用途）
KNOWLEDGE_BASE=/path/to/your/problem-bank-catalogs

# === 全流程模拟（src/sim/，见dev-docs/017）——生产绝不设置 ===
# SIM_MODE=1
# P27_REDIS_PREFIX=p27sim:
# HANDOVER_TIMEOUT_SECONDS=600
# （ARANGO_DB在sim中由run_sim自动覆盖为p27sim，生产用上面的正式值）
